# Telegram Bot Token (required) - get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Restrict access to specific Telegram user IDs (comma-separated, optional)
# Leave empty to auto-register the first /start user
TELEGRAM_ALLOWED_USERS=

# Claude Code working directory (default: current directory)
CLAUDE_WORK_DIR=/path/to/your/project

# Claude CLI total timeout in seconds (default: 1800 = 30 min)
CLAUDE_TIMEOUT=1800

# Heartbeat interval: update "Thinking..." message every N seconds (default: 30)
HEARTBEAT_INTERVAL=30

# Stall warning: warn user (not kill) if no output for N seconds (default: 300 = 5 min)
# Only CLAUDE_TIMEOUT actually kills the process. Use /kill to manually stop stuck sessions.
STALL_WARN_TIMEOUT=300

# Max agentic turns per call to prevent infinite loops (default: 30)
CLAUDE_MAX_TURNS=30

# ─── Group Mode Configuration ─────────────────────────────────────────────

# Bot owner's Telegram user ID (for group mode, owner isolation)
# If not set, derives from the first entry in TELEGRAM_ALLOWED_USERS
# TELEGRAM_OWNER_ID=123456789

# Shared directory for bot-to-bot communication (all bots must have access)
# Structure: {dir}/requests/{id}.json, {dir}/discussions/{id}/...
# Leave empty to disable group discussion features
# GROUP_SHARED_DIR=/home/shared/tgcc-group

# Polling interval for checking shared directory (seconds, default: 2.0)
# GROUP_POLL_INTERVAL=2.0
